def _safe_scalar_from_metadata(metadata, names, default):
    if metadata is None:
        return float(default)
    if isinstance(names, str):
        names = [names]
    for name in names:
        if name in metadata:
            v = metadata.get(name)
            try:
                if hasattr(v, "item"):
                    v = v.item()
                return float(v)
            except Exception:
                pass
    return float(default)


def _safe_normalize_channels(metadata):
    if metadata is None:
        metadata = {}

    channels = metadata.get("channels", metadata.get("input_channels", {}))

    if hasattr(channels, "item"):
        try:
            channels = channels.item()
        except Exception:
            pass

    if isinstance(channels, dict):
        channels = dict(channels)
    elif isinstance(channels, (list, tuple)):
        channels = {str(name): i for i, name in enumerate(channels)}
    else:
        channels = {}

    # Universal aliases
    if "u_previous" not in channels:
        for name in ["u_previous", "u0", "u_initial", "initial", "previous", "u"]:
            if name in channels:
                channels["u_previous"] = channels[name]
                break

    if "dt" not in channels:
        for name in ["dt", "time", "t", "T", "final_time"]:
            if name in channels:
                channels["dt"] = channels[name]
                break

    if "epsilon" not in channels:
        for name in ["epsilon", "eps", "epsilon_field"]:
            if name in channels:
                channels["epsilon"] = channels[name]
                break

    if "alpha" not in channels:
        for name in ["alpha", "diffusion", "diffusivity", "kappa"]:
            if name in channels:
                channels["alpha"] = channels[name]
                break

    if "nu" not in channels:
        for name in ["nu", "viscosity"]:
            if name in channels:
                channels["nu"] = channels[name]
                break

    if "source_f" not in channels:
        for name in ["source_f", "f", "source", "rhs"]:
            if name in channels:
                channels["source_f"] = channels[name]
                break

    # Conservative defaults by input position
    channels.setdefault("u_previous", 0)
    channels.setdefault("u0", channels.get("u_previous", 0))
    channels.setdefault("epsilon", 1)
    channels.setdefault("eps", channels.get("epsilon", 1))
    channels.setdefault("alpha", 1)
    channels.setdefault("nu", 1)
    channels.setdefault("dt", 2)
    channels.setdefault("time", channels.get("dt", 2))
    channels.setdefault("source_f", 0)

    out = {}
    for k, v in channels.items():
        try:
            out[str(k)] = int(v)
        except Exception:
            pass
    return out


def _safe_channel(raw_x, channels, names, default_index, default_value=1.0):
    import tensorflow as tf

    if isinstance(names, str):
        names = [names]

    idx = None
    for name in names:
        if name in channels:
            idx = int(channels[name])
            break
    if idx is None:
        idx = int(default_index)

    rank = raw_x.shape.rank
    nchan = raw_x.shape[-1]

    if nchan is not None and idx < nchan:
        return raw_x[..., idx:idx + 1]

    # Fallback constant field
    if rank == 3:
        shape = tf.concat([tf.shape(raw_x)[:2], [1]], axis=0)
    elif rank == 4:
        shape = tf.concat([tf.shape(raw_x)[:3], [1]], axis=0)
    else:
        shape = tf.shape(raw_x)

    return tf.ones(shape, dtype=raw_x.dtype) * tf.cast(default_value, raw_x.dtype)


def _safe_mean_square(x):
    import tensorflow as tf
    return tf.reduce_mean(tf.square(x))


def _safe_laplace1d_periodic(u, h):
    import tensorflow as tf
    return (tf.roll(u, 1, axis=1) - 2.0 * u + tf.roll(u, -1, axis=1)) / (h * h)


def _safe_grad1d_periodic(u, h):
    import tensorflow as tf
    return (tf.roll(u, -1, axis=1) - tf.roll(u, 1, axis=1)) / (2.0 * h)


def _safe_laplace2d_periodic(u, h):
    import tensorflow as tf
    return (
        tf.roll(u, 1, axis=1)
        + tf.roll(u, -1, axis=1)
        + tf.roll(u, 1, axis=2)
        + tf.roll(u, -1, axis=2)
        - 4.0 * u
    ) / (h * h)


def _safe_task_name(task):
    if isinstance(task, bytes):
        return task.decode("utf-8")
    return str(task)


def _safe_pde_residual(task, raw_x, pred, metadata):
    import tensorflow as tf

    task = _safe_task_name(task)
    channels = _safe_normalize_channels(metadata)

    h_val = _safe_scalar_from_metadata(metadata, ["h", "dx", "grid_spacing"], 1.0)
    dt_val = _safe_scalar_from_metadata(metadata, ["dt", "time", "T", "final_time"], 1.0)

    h = tf.cast(h_val, pred.dtype)
    dt_default = tf.cast(dt_val, pred.dtype)

    raw_x = tf.cast(raw_x, pred.dtype)
    pred = tf.cast(pred, pred.dtype)

    if task == "burgers":
        u0 = _safe_channel(raw_x, channels, ["u_previous", "u0"], 0, 0.0)
        nu = _safe_channel(raw_x, channels, ["nu", "viscosity"], 1, 1e-3)
        dt = _safe_channel(raw_x, channels, ["dt", "time", "T"], 2, dt_val)
        dt = tf.maximum(tf.cast(dt, pred.dtype), tf.cast(1e-6, pred.dtype))
        ux = _safe_grad1d_periodic(pred, h)
        uxx = _safe_laplace1d_periodic(pred, h)
        return (pred - u0) / dt + pred * ux - nu * uxx

    if task == "allen_cahn":
        u0 = _safe_channel(raw_x, channels, ["u_previous", "u0"], 0, 0.0)
        eps = _safe_channel(raw_x, channels, ["epsilon", "eps"], 1, 0.03)
        dt = _safe_channel(raw_x, channels, ["dt", "time", "T", "final_time"], 2, dt_val)
        dt = tf.maximum(tf.cast(dt, pred.dtype), tf.cast(1e-6, pred.dtype))
        uxx = _safe_laplace1d_periodic(pred, h)
        return (pred - u0) / dt - eps * eps * uxx - pred + pred * pred * pred

    if task in ["trig_n4", "peak", "exp_trig"]:
        f = _safe_channel(raw_x, channels, ["source_f", "f", "source", "rhs"], 0, 0.0)
        lap = _safe_laplace2d_periodic(pred, h)
        return -lap - f

    if task == "gaussian":
        u0 = _safe_channel(raw_x, channels, ["u_previous", "u0"], 0, 0.0)
        alpha = _safe_channel(raw_x, channels, ["alpha", "diffusion", "kappa"], 1, 0.005)
        t = _safe_channel(raw_x, channels, ["time", "t", "T", "dt"], 2, dt_val)
        t = tf.maximum(tf.cast(t, pred.dtype), tf.cast(1e-6, pred.dtype))
        lap = _safe_laplace2d_periodic(pred, h)
        return (pred - u0) / t - alpha * lap

    # Unknown task: return zero residual rather than crashing.
    return tf.zeros_like(pred)


def _safe_residual_reference_scale(task, raw_x, target, metadata):
    import tensorflow as tf

    try:
        res = _safe_pde_residual(task, raw_x, target, metadata)
        scale = _safe_mean_square(res)
    except Exception:
        scale = tf.constant(1.0, dtype=target.dtype)

    return tf.maximum(tf.cast(scale, target.dtype), tf.cast(1e-6, target.dtype))


